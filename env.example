# Environment variables for AI Dev Assistant

# LLM provider: qwen (local default) | ollama | gemini | openrouter
LLM_PROVIDER=qwen

# Ollama — install from https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# Qwen via Ollama (Mac M3 friendly, strong tool calling)
QWEN_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=300

# Google AI (Gemini) — used when LLM_PROVIDER=gemini
#   gemini-3.1-flash-lite   — lighter / higher free-tier limits (recommended)
#   gemini-3.5-flash        — Gemini 3 Flash
GOOGLE_AI_API_KEY=your-google-ai-api-key-here
GOOGLE_AI_MODEL=gemini-3.1-flash-lite

# Gemini rate limits (RPM spacing + retry on transient 429)
GEMINI_RATE_LIMIT_MS=13000
GEMINI_RETRY_MAX=3
GEMINI_RETRY_BACKOFF_MS=10000

# When Gemini free-tier daily quota is exhausted, switch provider (restart backend):
# LLM_PROVIDER=openrouter
# LLM_PROVIDER=qwen

# OpenRouter — only needed when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=300

# SDLC workflow: 0 = mock/fake data (default), 1 = real LangGraph + LLM
SDLC_USE_API=0

# Max tool calls per SDLC stage (write_file, run_code, etc.). Implementation uses the full budget.
AGENT_MAX_STEPS=50

# Neo4j (graph + vector search) — data persists in Docker volume neo4j_data
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_VECTOR_DIMENSIONS=1024

# Backend Configuration
SERVER_PORT=8080

# Frontend Configuration
VITE_API_URL=http://localhost:8080
# Mirror of SDLC_USE_API for UI labels (0 mock, 1 real). Backend flag is authoritative.
VITE_SDLC_USE_API=0
